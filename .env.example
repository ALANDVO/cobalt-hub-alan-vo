# Cobalt Hub - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Cobalt Hub
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/cobalt_hub.db

# Authentication (OIDC/Keycloak)
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/cobalt-hub
OIDC_CLIENT_ID=cobalt-hub-backend
OIDC_CLIENT_SECRET=cobalt-hub-backend-secret-change-in-production
OIDC_AUDIENCE=cobalt-hub-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/cobalt-hub/protocol/openid-connect/certs

# LLM Configuration (optional - for opt-in explanations)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=30.0

# CORS
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Demo Mode (local-only, explicitly enabled)
DEMO_MODE=true
DEMO_USER_ID=demo-user
DEMO_USER_ROLES=["viewer","operator"]

# Keycloak Admin (for realm import)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=cobalt-hub-backend-secret-change-in-production